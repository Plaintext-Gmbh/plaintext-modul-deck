<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Karte 2162: eigenes Plaintext-Modul (Muster plaintext-modul-notizen, Karte 2096). Parent = root-v2,
         alle root-Teile "provided": die Anwendung, in die das Modul kommt, bringt sie mit. -->
    <parent>
        <groupId>ch.plaintext.v2</groupId>
        <artifactId>plaintext-root-parent</artifactId>
        <version>3.31.0</version>
        <relativePath/>
    </parent>

    <groupId>ch.plaintext</groupId>
    <artifactId>plaintext-modul-deck</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>plaintext-modul-deck</name>
    <description>Kanban-Board und Agenten-Kollaboration (Karten, Rückfragen, Chat, Postfach per MCP) für Plaintext-Anwendungen</description>
    <url>https://github.com/Plaintext-Gmbh/plaintext-modul-deck</url>

    <licenses>
        <license>
            <name>MPL-2.0</name>
            <url>https://mozilla.org/MPL/2.0/</url>
        </license>
    </licenses>

    <properties>
        <!-- gleich der Parent-Version, sonst setzt der root-Parent sie auf project.version -->
        <plaintext-root.version>3.31.0</plaintext-root.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.plaintext.v2</groupId>
            <artifactId>plaintext-root-webapp</artifactId>
            <version>${plaintext-root.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- MCP-Werkzeuge: die Anwendung bringt den MCP-Server mit, das Modul braucht ihn nur zum Kompilieren. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>2.0.2</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Quell-Jar: plaintext-app entpackt es vor den Tests nach externe-module/ fuer die Architekturtests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>quellen</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>plaintext-nas</id>
            <url>https://maven.plaintext.ch/releases</url>
        </repository>
        <repository>
            <id>plaintext</id>
            <url>https://maven.pkg.github.com/Plaintext-Gmbh/plaintext-mvn</url>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>plaintext-nas</id>
            <url>https://maven.plaintext.ch/releases</url>
        </repository>
    </distributionManagement>
</project>
